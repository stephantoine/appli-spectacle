<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.paint.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.control.*?>
<?import java.lang.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vue.CtrlRechercherResa">
   <children>
      <VBox alignment="TOP_CENTER" prefHeight="150.0" prefWidth="100.0">
         <children>
            <Label text="Réservator" textFill="#d00505">
               <font>
                  <Font name="System Bold" size="28.0" />
               </font>
               <VBox.margin>
                  <Insets top="25.0" />
               </VBox.margin>
            </Label>
            <Label text="Rechercher une réservation">
               <font>
                  <Font size="16.0" />
               </font>
               <VBox.margin>
                  <Insets top="25.0" />
               </VBox.margin>
            </Label>
         </children>
      </VBox>
      <HBox alignment="CENTER" prefHeight="60.0" prefWidth="200.0">
         <children>
            <Label prefHeight="30.0" text="Nom du client : ">
               <HBox.margin>
                  <Insets right="15.0" />
               </HBox.margin>
               <font>
                  <Font size="16.0" />
               </font>
            </Label>
            <TextField fx:id="txtNom" maxHeight="30.0" minHeight="30.0" onKeyReleased="#keyReleasedNom" prefHeight="30.0">
               <HBox.margin>
                  <Insets />
               </HBox.margin>
            </TextField>
         </children>
         <VBox.margin>
            <Insets />
         </VBox.margin>
      </HBox>
      <HBox alignment="CENTER" prefHeight="50.0" prefWidth="200.0">
         <children>
            <Label fx:id="labelErreurSaisieNom" alignment="CENTER" maxHeight="15.0" minHeight="15.0" prefHeight="15.0" textFill="#f50707" />
         </children>
         <padding>
            <Insets bottom="10.0" />
         </padding>
      </HBox>
      <HBox alignment="CENTER">
         <children>
            <Label prefHeight="30.0" text="Ville du client : ">
               <HBox.margin>
                  <Insets right="15.0" />
               </HBox.margin>
               <font>
                  <Font size="16.0" />
               </font>
            </Label>
            <TextField fx:id="txtVille" maxHeight="30.0" minHeight="30.0" onKeyReleased="#keyReleasedVille" prefHeight="30.0">
               <HBox.margin>
                  <Insets />
               </HBox.margin></TextField>
         </children>
         <VBox.margin>
            <Insets />
         </VBox.margin>
      </HBox>
      <HBox alignment="CENTER" prefHeight="50.0" prefWidth="200.0">
         <children>
            <Label fx:id="labelErreurSaisieVille" maxHeight="15.0" minHeight="15.0" prefHeight="15.0" textFill="#f50707" />
         </children>
      </HBox>
      <VBox alignment="BOTTOM_RIGHT" prefHeight="125.0">
         <children>
            <Button fx:id="bnRechercher" defaultButton="true" maxHeight="30.0" maxWidth="110.0" minHeight="20.0" minWidth="100.0" mnemonicParsing="false" onAction="#clicBnRechercher" prefHeight="30.0" prefWidth="110.0" text="Rechercher">
               <VBox.margin>
                  <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
               </VBox.margin>
            </Button>
            <Button fx:id="labelAnnuler" cancelButton="true" maxHeight="30.0" maxWidth="110.0" minHeight="20.0" minWidth="100.0" mnemonicParsing="false" onAction="#clicBnAnnuler" prefHeight="30.0" prefWidth="110.0" text="Annuler">
               <VBox.margin>
                  <Insets bottom="15.0" left="15.0" right="15.0" />
               </VBox.margin>
            </Button>
         </children>
      </VBox>
   </children>
</VBox>
